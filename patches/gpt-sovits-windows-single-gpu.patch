+    # so saved checkpoints stay byte-compatible with the WebUI's.
+    class _SingleGPUWrap(torch.nn.Module):
+        def __init__(self, m):
+            super().__init__()
+            self.module = m
+
+        def forward(self, *a, **kw):
+            return self.module(*a, **kw)
+
+    _no_ddp = n_gpus <= 1 and os.environ.get("GSV_NO_DDP", "1") == "1"
+    if torch.cuda.is_available() and not _no_ddp:
