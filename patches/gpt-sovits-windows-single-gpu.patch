@@ -108,6 +108,30 @@ def main(args):
     logger = TensorBoardLogger(name=output_dir.stem, save_dir=output_dir)
     os.environ["MASTER_ADDR"] = "localhost"
     os.environ["USE_LIBUV"] = "0"
+    # LOCAL PATCH (pairs with the single-GPU "auto" strategy below): AR/data/
+    # bucket_sampler.py calls dist.get_world_size()/get_rank() whenever CUDA is
+    # available, without checking that a process group exists. DDPStrategy used to
+    # create that group for it; "auto" does not, so initialise a 1-process group
+    # here. This gives the sampler world_size=1 / rank=0 while keeping DDP's
+    # reducer (which segfaults on Windows gloo) out of the backward pass.
+    _single_gpu = (
+        torch.cuda.is_available()
+        and torch.cuda.device_count() <= 1
+        and os.environ.get("GSV_NO_DDP", "1") == "1"
+    )
+    if _single_gpu:
+        import random as _random
+
+        import torch.distributed as _dist
+
+        if not _dist.is_initialized():
+            os.environ.setdefault("MASTER_PORT", str(_random.randint(20000, 55555)))
+            _dist.init_process_group(
+                backend="gloo",
+                init_method="env://?use_libuv=False",
+                world_size=1,
+                rank=0,
+            )
     trainer: Trainer = Trainer(
         max_epochs=config["train"]["epochs"],
         accelerator="gpu" if torch.cuda.is_available() else "cpu",
@@ -117,8 +141,14 @@ def main(args):
