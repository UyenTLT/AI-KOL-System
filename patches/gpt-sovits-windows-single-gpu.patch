-    if torch.cuda.is_available():
+    # LOCAL PATCH: skip DDP on a single GPU (set GSV_NO_DDP=0 to force it back on).
+    # DDP with one process is semantically a no-op, but its reducer hooks into the
+    # backward pass; with the Windows `gloo` backend + find_unused_parameters=True
+    # that reducer segfaults (0xC0000005) on the first backward. Unwrapped
+    # single-GPU training is numerically identical here.
+    #
+    # _SingleGPUWrap keeps DDP's interface so the rest of this file is untouched:
+    # it exposes `.module` (used in 5 places) and, because `module` is a real
