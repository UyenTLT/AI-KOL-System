# macOS
.DS_Store
._*

# Editor
.vscode/
*.swp

# Python
__pycache__/
*.pyc

# Local-only reports (kept out of version control)
reports/

# Talking-web generated clips
tools/talking_web/_out/

# Virtual environments
.venv/
venv/

# Third-party engines cloned into the repo (multi-GB with weights).
# Leading slash anchors these to the repo root -- without it the pattern also
# matched our own tools/livetalking/ (Windows paths are case-insensitive), which
# silently excluded the launcher scripts from version control.
/GPT-SoVITS/
/LiveTalking/

# Voice data: source audio + intermediates are large and re-derivable.
# The .list manifest and QC report ARE tracked so a dataset stays reproducible.
kols/*/voice/raw/
kols/*/voice/work/
kols/*/voice/dataset/*.wav

# PENDING RIGHTS DECISION — not published.
# This dataset was derived from a podcast recording while testing the crawl pipeline, so its
# .list/manifest contain a real person's transcripts. That conflicts with the synthetic-only
# voice policy (CUDA_SETUP.md section I), so it is excluded until someone confirms the rights.
# Delete these two lines to publish it, or delete kols/sofia-vargas/voice/ to drop it.
kols/sofia-vargas/voice/

